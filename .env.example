# === 数据库 ===
POSTGRES_USER=agentstation
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=agent_station
DATABASE_URL=postgresql://agentstation:CHANGE_ME_STRONG_PASSWORD@postgres:5432/agent_station

# === 向量库 ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Embedding (SiliconFlow) ===
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=YOUR_SILICONFLOW_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# === API ===
API_SECRET_KEY=GENERATE_32_BYTES_RANDOM
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=sk-as-GENERATE_RANDOM

# === Markdown ===
MARKDOWN_ROOT=/data/markdown

# === 前端 ===
# 留空则前端使用相对路径（自动跟随部署域名）；如需硬编码可填完整 URL
VITE_API_BASE=
VITE_WS_BASE=