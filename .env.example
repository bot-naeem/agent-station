# === 数据库 ===
POSTGRES_USER=agentlog
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=agent_logs
DATABASE_URL=postgresql://agentlog:CHANGE_ME_STRONG_PASSWORD@postgres:5432/agent_logs

# === 向量库 ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Embedding (SiliconFlow) ===
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=YOUR_SILICONFLOW_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# === API ===
API_SECRET_KEY=GENERATE_32_BYTES_RANDOM
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=sk-agent-log-GENERATE_RANDOM

# === Markdown ===
MARKDOWN_ROOT=/data/markdown

# === 前端 ===
VITE_API_BASE=https://codingfamily.online/api/v1
