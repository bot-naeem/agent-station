# === 数据库 ===
# PostgreSQL 连接基础配置（生产环境请务必自行生成强密码）
POSTGRES_USER=agentstation
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agent_station
DATABASE_URL=postgresql://agentstation:CHANGE_ME@postgres:5432/agent_station

# === API ===
# JWT 签名密钥（首次部署请用 ./scripts/deploy/deploy.sh 自动生成，或自行生成 32 字节随机字符串）
API_SECRET_KEY=GENERATE_32_BYTES_RANDOM
# 监听地址（生产建议改为 0.0.0.0 并配合反向代理）
API_HOST=0.0.0.0
API_PORT=8000
# 管理员/ bootstrap API Key（格式：sk-as-后跟 32 字节随机字符串，首次登录使用，创建后妥善保存）
API_KEY=sk-as-GENERATE_RANDOM

# === Markdown ===
# Agent 写入的工作日志根目录（容器内路径，生产环境建议挂载持久化存储）
MARKDOWN_ROOT=/data/markdown

# === 前端 ===
# VITE_API_BASE 留空则使用相对路径（随部署域名自动适配）；
# 如需硬编码可填写完整 URL（如 https://your-domain.com/api/v1）
VITE_API_BASE=
# VITE_WS_BASE 留空则使用 wss://<当前域名>/ws；如需硬编码可填写完整 URL
VITE_WS_BASE=